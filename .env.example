# Prometheus de onde os dados sao lidos (precisa estar na mesma rede docker).
PROM_URL=http://prometheus:9090

# Rede docker externa a ser usada (precisa ja existir).
DOCKER_NETWORK=grafana_default

# Porta publicada no host.
TFT_API_PORT=9881

# Cache do JSON, em segundos. Mantenha acima do intervalo de poll da telinha.
CACHE_TTL=10
SCRAPE_TIMEOUT=8

# Mountpoints na ordem em que devem aparecer na tela.
DISK_MOUNTS=/,/mnt/backup

# Chip de temperatura como o node-exporter reporta em node_hwmon_temp_celsius.
TEMP_CHIP=platform_coretemp_0

# Expressoes PromQL da geracao solar. Ajuste aos nomes/labels da sua stack.
# Potencia (e rede/carga) deve resultar em W; energia em kWh apos o fator.
SOLAR_POWER_QUERY='sum(soliscloud_station_power_watts)'
SOLAR_TODAY_QUERY='sum(soliscloud_station_energy_kwh{period="day"})'
SOLAR_TOTAL_QUERY='sum(soliscloud_station_energy_kwh{period="total"})'
SOLAR_MONTH_QUERY='sum(soliscloud_station_energy_kwh{period="month"})'
SOLAR_YEAR_QUERY='sum(soliscloud_station_energy_kwh{period="year"})'
SOLAR_DAYLIGHT_QUERY='min(soliscloud_station_daylight)'
SOLAR_LIVE_QUERY='min(soliscloud_telemetry_live)'
SOLAR_GRID_QUERY=
SOLAR_LOAD_QUERY=
SOLAR_POWER_SCALE=1
SOLAR_ENERGY_SCALE=1
